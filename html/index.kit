<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Projektowanie nowoczesnych, responsywnych i funkcjonalnych stron internetowych.">
    <title>Sylwia - Strony internetowe</title>
    <link rel="stylesheet" href="./dist/css/main.min.css">
</head>

<body>
    <header class="site-header" data-header>
        <div class="container site-header__inner">

            <a class="brand" href="#start" aria-label="Sylwia Lesner - strona główna">
                <span class="brand__initials" aria-hidden="true">SL</span>
                <span class="brand__divider" aria-hidden="true"></span>
                <span class="brand__text">Strony Internetowe</span>
            </a>

            <button class="menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false"
                aria-label="Otwórz menu" data-menu-toggle>
                <span class="sr-only" data-menu-label>
                    Otwórz menu
                </span>

                <span class="menu-toggle__line"></span>
                <span class="menu-toggle__line"></span>
                <span class="menu-toggle__line"></span>
            </button>

            <nav class="site-nav" id="primary-navigation" aria-label="Główna nawigacja" data-navigation>
                <ul class="site-nav__list">
                    <li>
                        <a class="site-nav__link" href="#oferta">
                            Oferta
                        </a>
                    </li>

                    <li>
                        <a class="site-nav__link" href="#realizacje">
                            Realizacje
                        </a>
                    </li>

                    <li>
                        <a class="site-nav__link" href="#proces">
                            Proces
                        </a>
                    </li>
                    <li>
                        <a class="site-nav__link" href="#kontakt">
                            Kontakt
                        </a>
                    </li>
                </ul>
            </nav>

        </div>
    </header>

    <main id="main-content">
        <section class="hero" id="start">
            <div class="container hero__inner">

                <div class="hero__content">

                    <p class="hero__eyebrow">
                        Projektuję strony internetowe
                    </p>

                    <h1 class="hero__title">
                        <span>Zadbaj o</span>
                        <span>profesjonalny</span>
                        <span>wizerunek</span>
                        <span>swojej firmy</span>
                        <span>w internecie</span>
                    </h1>

                    <p class="hero__description">
                        Nowoczesna strona internetowa pomoże Ci wzbudzić
                        zaufanie, wyróżnić się na tle konkurencji i ułatwi
                        klientom kontakt z Twoją firmą.
                    </p>

                    <div class="hero__actions">
                        <a class="button button--primary" href="#kontakt">
                            Napisz
                        </a>

                        <a class="text-link" href="#realizacje">
                            <span>Zobacz realizacje</span>

                            <svg aria-hidden="true" viewBox="0 0 24 24">
                                <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5"
                                    stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </div>

                </div>


                <div class="hero__visual" data-hero-visual>

                    <div class="hero__glow"></div>

                    <div class="business-mockup">

                        <!-- Górny pasek przeglądarki -->

                        <div class="business-mockup__browser-bar">

                            <div class="business-mockup__dots">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>

                            <div class="business-mockup__url">
                                twojafirma.pl
                            </div>

                        </div>

                        <div class="business-mockup__screen">

                            <!-- KWIACIARNIA -->
                            <article class="business-slide is-active" data-business-panel="services"
                                aria-hidden="false">
                                <header class="mockup-site-header">
                                    <div class="mockup-logo">
                                        MAŁA FIRMA
                                    </div>

                                    <nav class="mockup-nav" aria-label="Nawigacja podglądu strony">
                                        <span>Oferta</span>
                                        <span>O nas</span>
                                        <span>Kontakt</span>
                                    </nav>

                                    <button class="mockup-menu" type="button" aria-label="Otwórz menu">
                                        <span></span>
                                        <span></span>
                                    </button>
                                </header>

                                <section class="mockup-hero">
                                    <div class="mockup-hero__content">

                                        <span class="mockup-eyebrow">
                                            DOBRE MIEJSCE
                                        </span>

                                        <h2>
                                            Dobre pierwsze<br>
                                            wrażenie ma<br>
                                            <em>znaczenie.</em>
                                        </h2>

                                        <p>
                                            Profesjonalna strona, która pracuje na Twój biznes.
                                        </p>

                                        <span class="mockup-cta">
                                            Zobacz ofertę
                                        </span>

                                    </div>

                                    <div class="mockup-hero__visual">
                                        <div class="mockup-main-image">
                                            <img src="/dist/img/myprojects/stronaInternetowaSylwiaLesner.png"
                                                alt="Podgląd realizacji strony internetowej dla kwiaciarni">
                                        </div>
                                    </div>
                                </section>

                                <section class="mockup-benefits" aria-label="Najważniejsze elementy strony">
                                    <div class="mockup-benefit">
                                        <span class="mockup-benefit__number">
                                            01
                                        </span>

                                        <strong>
                                            Przyciąga uwagę
                                        </strong>

                                        <small>
                                            Estetyczna prezentacja
                                        </small>
                                    </div>

                                    <div class="mockup-benefit">
                                        <span class="mockup-benefit__number">
                                            02
                                        </span>

                                        <strong>
                                            Ułatwia decyzję
                                        </strong>

                                        <small>
                                            Czytelna oferta
                                        </small>
                                    </div>

                                    <div class="mockup-benefit">
                                        <span class="mockup-benefit__number">
                                            03
                                        </span>

                                        <strong>
                                            Zamienia odwiedziny w kontakt
                                        </strong>

                                        <small>
                                            Proste zamówienie
                                        </small>
                                    </div>
                                </section>
                            </article>


                            <!-- USŁUGI ZIEMNE -->
                            <article class="business-slide" data-business-panel="beauty" aria-hidden="true">
                                <header class="mockup-site-header">
                                    <div class="mockup-logo">
                                        LOKALNY BIZNES
                                    </div>

                                    <nav class="mockup-nav" aria-label="Nawigacja podglądu strony">
                                        <span>Usługi</span>
                                        <span>Sprzęt</span>
                                        <span>Kontakt</span>
                                    </nav>

                                    <button class="mockup-menu" type="button" aria-label="Otwórz menu">
                                        <span></span>
                                        <span></span>
                                    </button>
                                </header>

                                <section class="mockup-hero">
                                    <div class="mockup-hero__content">

                                        <span class="mockup-eyebrow">
                                            DOBRA ROBOTA
                                        </span>

                                        <h2>
                                            Daj klientowi<br> powód, żeby<br> <em>Ci zaufał.</em>
                                        </h2>

                                        <p>
                                            Profesjonalna obecność w sieci pomaga przekonać klienta, że warto Ci zaufać.
                                        </p>

                                        <span class="mockup-cta">
                                            Sprawdź usługi
                                        </span>

                                    </div>

                                    <div class="mockup-hero__visual">
                                        <div class="mockup-main-image">
                                            <img src="/dist/img/myprojects/sylwialesnermockup.png"
                                                alt="Podgląd realizacji strony internetowej firmy oferującej usługi koparką i wywrotką">
                                        </div>
                                    </div>
                                </section>

                                <section class="mockup-benefits" aria-label="Najważniejsze elementy strony">
                                    <div class="mockup-benefit">
                                        <span class="mockup-benefit__number">
                                            01
                                        </span>

                                        <strong>
                                            Buduje zaufanie
                                        </strong>

                                        <small>
                                            Profesjonalny wizerunek
                                        </small>
                                    </div>

                                    <div class="mockup-benefit">
                                        <span class="mockup-benefit__number">
                                            02
                                        </span>

                                        <strong>
                                            Pokazuje Twoją wartość
                                        </strong>

                                        <small>
                                            Jasna prezentacja oferty
                                        </small>
                                    </div>

                                    <div class="mockup-benefit">
                                        <span class="mockup-benefit__number">
                                            03
                                        </span>

                                        <strong>
                                            Wyróżnia Cię na tle innych
                                        </strong>

                                        <small>
                                            Spójna obecnośc w sieci
                                        </small>
                                    </div>
                                </section>
                            </article>


                            <!-- APARTAMENT -->
                            <article class="business-slide" data-business-panel="restaurant" aria-hidden="true">
                                <header class="mockup-site-header">
                                    <div class="mockup-logo">
                                        GOŚCINNOŚĆ
                                    </div>

                                    <nav class="mockup-nav" aria-label="Nawigacja podglądu strony">
                                        <span>Apartament</span>
                                        <span>Galeria</span>
                                        <span>Kontakt</span>
                                    </nav>

                                    <button class="mockup-menu" type="button" aria-label="Otwórz menu">
                                        <span></span>
                                        <span></span>
                                    </button>
                                </header>

                                <section class="mockup-hero">
                                    <div class="mockup-hero__content">

                                        <span class="mockup-eyebrow">
                                            DOBRY WYBÓR
                                        </span>

                                        <h2>
                                            Ułatw klientowi<br> podjąć dobrą<br> <em>decyzję.</em>
                                        </h2>

                                        <p>
                                            Dobra strona prowadzi klienta od pierwszego wrażenia do konkretnej decyzji.
                                        </p>

                                        <span class="mockup-cta">
                                            Zobacz apartament
                                        </span>

                                    </div>

                                    <div class="mockup-hero__visual">
                                        <div class="mockup-main-image">
                                            <img src="/dist/img/myprojects/apartmanLastovickaSylwiaLesner.png"
                                                alt="Podgląd realizacji strony internetowej apartamentu">
                                        </div>
                                    </div>
                                </section>

                                <section class="mockup-benefits" aria-label="Najważniejsze elementy strony">
                                    <div class="mockup-benefit">
                                        <span class="mockup-benefit__number">
                                            01
                                        </span>

                                        <strong>
                                            Przyciąga uwagę
                                        </strong>

                                        <small>
                                            Spójna prezentacja
                                        </small>
                                    </div>

                                    <div class="mockup-benefit">
                                        <span class="mockup-benefit__number">
                                            02
                                        </span>

                                        <strong>
                                            Buduje zainteresowanie
                                        </strong>

                                        <small>
                                            Najważniejsze informacje
                                        </small>
                                    </div>

                                    <div class="mockup-benefit">
                                        <span class="mockup-benefit__number">
                                            03
                                        </span>

                                        <strong>
                                            Ułatwia decyzję
                                        </strong>

                                        <small>
                                            Prosty kontakt
                                        </small>
                                    </div>
                                </section>
                            </article>

                        </div>
                    </div>
                    <!-- Selektor realizacji -->
                    <div class="mockup-selector" role="group" aria-labelledby="mockup-selector-label">
                        <span class="mockup-selector__label" id="mockup-selector-label">
                            Zobacz moje realizacje
                        </span>

                        <div class="mockup-selector__buttons">

                            <button type="button" class="mockup-selector__button is-active" data-business="services"
                                aria-pressed="true">
                                Kwiaciarnia
                            </button>

                            <button type="button" class="mockup-selector__button" data-business="beauty"
                                aria-pressed="false">
                                Usługi ziemne
                            </button>

                            <button type="button" class="mockup-selector__button" data-business="restaurant"
                                aria-pressed="false">
                                Apartament
                            </button>

                        </div>
                    </div>
        </section>

        <section class="conversion-panel section">
            <div class="container">
                <div class="conversion-panel__box">
                    <div class="conversion-panel__content">
                        <h2 class="conversion-panel__title">
                            Twoja firma ma coś co warto pokazać
                        </h2>

                        <p class="conversion-panel__description">
                            Dobra strona nie zaczyna się od szablonu. Zaczyna się od zrozumienia Twojej firmy i tego,
                            czego szuka Twój klient.
                        </p>
                        <br>
                        <p class="conversion-panel__description">
                            Pomogę Ci pokazać to, co w Twojej ofercie najważniejsze - w prosty, przemyślany i atrakcyjny
                            sposób.
                        </p>
                    </div>

                    <a class="button button--primary conversion-panel__button" href="#kontakt">
                        Porozmawiajmy
                    </a>
                </div>
            </div>
        </section>

        <!-- OFERTA -->
        <section class="services section" id="oferta">
            <div class="container">

                <div class="section-heading section-heading--center">
                    <h2 class="section-heading__eyebrow">
                        Oferta
                    </h2>

                    <h3 class="services__title">
                        Pomagam poukładać to, jak Twoja firma wygląda w internecie.
                    </h3>

                    <p class="services__intro">
                        Od strony internetowej, przez wizytówkę Google, aż po podstawy SEO.
                        Zadbamy o to, żeby klient łatwo Cię znalazł, poznał Twoją ofertę
                        i wiedział, dlaczego warto wybrać właśnie Ciebie.
                    </p>
                </div>

                <div class="services__grid">

                    <article class="service">
                        <div class="service__icon" aria-hidden="true">
                            <svg viewBox="0 0 48 48">
                                <rect x="8" y="9" width="32" height="23" rx="1" />
                                <path d="M19 39h10M24 32v7" />
                            </svg>
                        </div>

                        <h3 class="service__title">
                            Strona internetowa
                        </h3>

                        <p class="service__description">
                            Nowoczesna strona dopasowana do Twojej firmy, klientów i oferty.
                            Przemyślana tak, żeby dobrze reprezentowała Twój biznes.
                        </p>
                    </article>

                    <article class="service">
                        <div class="service__icon" aria-hidden="true">
                            <svg viewBox="0 0 48 48">
                                <rect x="10" y="7" width="28" height="34" rx="2" />
                                <path d="M17 14h14M17 20h10M17 28h14M17 34h8" />
                            </svg>
                        </div>

                        <h3 class="service__title">
                            One Page
                        </h3>

                        <p class="service__description">
                            Prosta i konkretna strona dla małej firmy, nowej usługi
                            albo jednej oferty, którą chcesz dobrze pokazać.
                        </p>
                    </article>

                    <article class="service">
                        <div class="service__icon" aria-hidden="true">
                            <svg viewBox="0 0 48 48">
                                <path d="M24 42s13-10 13-21A13 13 0 0 0 11 21c0 11 13 21 13 21Z" />
                                <circle cx="24" cy="21" r="4" />
                            </svg>
                        </div>

                        <h3 class="service__title">
                            Wizytówka Google
                        </h3>

                        <p class="service__description">
                            Pomogę dobrze przygotować Profil Firmy w Google,
                            żeby klienci łatwiej mogli Cię znaleźć i skontaktować się z Tobą.
                        </p>
                    </article>

                    <article class="service">
                        <div class="service__icon" aria-hidden="true">
                            <svg viewBox="0 0 48 48">
                                <circle cx="22" cy="22" r="13" />
                                <path d="m32 32 9 9M17 25l4-5 4 3 5-7" />
                            </svg>
                        </div>

                        <h3 class="service__title">
                            Widoczność w Google
                        </h3>

                        <p class="service__description">
                            Zadbam o techniczne podstawy SEO i strukturę strony,
                            żeby była dobrze przygotowana do wyszukiwania przez klientów.
                        </p>
                    </article>

                    <article class="service">
                        <div class="service__icon" aria-hidden="true">
                            <svg viewBox="0 0 48 48">
                                <path d="M24 8a16 16 0 1 0 16 16" />
                                <path d="M24 8v8M24 24l6 4" />
                                <path d="M34 8h6v6" />
                            </svg>
                        </div>

                        <h3 class="service__title">
                            Opieka nad stroną
                        </h3>

                        <p class="service__description">
                            Aktualizacje, zmiany treści i drobne poprawki,
                            kiedy chcesz coś zmienić lub dodać na swojej stronie.
                        </p>
                    </article>

                    <article class="service">
                        <div class="service__icon" aria-hidden="true">
                            <svg viewBox="0 0 48 48">
                                <path d="M9 12h30v25H9z" />
                                <path d="M15 18h18M15 24h12M15 30h8" />
                                <path d="m34 32 5 5M35 29l-6 6" />
                            </svg>
                        </div>

                        <h3 class="service__title">
                            Odświeżenie strony
                        </h3>

                        <p class="service__description">
                            Masz już stronę, ale nie jesteś z niej zadowolony?
                            Poprawimy jej wygląd, treści i układ, żeby lepiej służyła Twojej firmie.
                        </p>
                    </article>

                </div>
            </div>
        </section>


        <!-- CONVERSION SECTION -->
        <section class="conversion-panel section">
            <div class="container">
                <div class="conversion-panel__box">
                    <div class="conversion-panel__content">
                        <h2 class="conversion-panel__title">
                            Zacznijmy od tego, czego naprawdę potrzebujesz
                        </h2>

                        <p class="conversion-panel__description">
                            Nie każdy biznes potrzebuje rozbudowanej strony, wielu podstron czy dodatkowych funkcji.
                            Dlatego zamiast wciskać gotowy pakiet, skupiamy się na tym, co faktycznie ma pomóc Twojej
                            firmie w internecie.
                        </p>
                    </div>

                    <a class="button button--primary conversion-panel__button" href="#kontakt">
                        Opowiedz mi o swojej firmie
                    </a>
                </div>
            </div>
        </section>

        <!-- REALIZACJE -->

        <section class="projects section" id="realizacje">
            <div class="container">

                <div class="section-heading section-heading--center">
                    <h2 class="section-heading__eyebrow">
                        Realizacje
                    </h2>
                    <!-- 
                    <h2 class="section-heading__title">
                        Ostatnie projekty
                    </h2> -->
                </div>

                <div class="projects__grid">
                    <article class="project">
                        <a class="project__link" href="https://lessyl.github.io/kwiaciarnia/" target="_blank"
                            rel="noopener noreferrer" aria-label="Zobacz projekt strony dla kwiaciarni">

                            <picture>
                                <source media="(max-width: 767px)" srcset="./dist/img/myprojects/kwiaciarnia-768.webp">

                                <img class="project__image" src="./dist/img/myprojects/kwiaciarnia-1600.webp"
                                    alt="Projekt strony internetowej dla kwiaciarni" width="1600" height="960"
                                    loading="lazy" decoding="async">
                            </picture>

                            <span class="project__overlay">
                                Zobacz projekt
                            </span>
                        </a>
                    </article>
                    <article class="project">
                        <a class="project__link" href="https://rbtranskop.pl/" target="_blank" rel="noopener noreferrer"
                            aria-label="Zobacz projekt strony dla firmy usługowej RBTranskop z Luzina">

                            <picture>
                                <source media="(max-width: 767px)" srcset="./dist/img/myprojects/rbtranskop-768.webp">

                                <img class="project__image" src="./dist/img/myprojects/rbtranskop-1600.webp"
                                    alt="Projekt strony internetowej firmy RBTranskop" width="1600" height="960"
                                    loading="lazy" decoding="async">
                            </picture>

                            <span class="project__overlay">
                                Zobacz projekt
                            </span>
                        </a>
                    </article>
                    <article class="project">
                        <a class="project__link" href="https://apartlastovicka.sk/" target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Zobacz projekt strony dla Apart Lastovicka na Słowacji">

                            <picture>
                                <source media="(max-width: 767px)"
                                    srcset="./dist/img/myprojects/apartlastovicka-768.webp">

                                <img class="project__image" src="./dist/img/myprojects/apartLastovicka-1600.webp"
                                    alt="Projekt strony internetowej Apart Lastovicka na Słowacji" width="1600"
                                    height="960" loading="lazy" decoding="async">
                            </picture>

                            <span class="project__overlay">
                                Zobacz projekt
                            </span>
                        </a>
                    </article>

                </div>
            </div>
        </section>
        <!-- PROCES -->
        <section class="process section" id="proces">
            <div class="container">

                <div class="section-heading section-heading--center">
                    <h2 class="section-heading__eyebrow">
                        Proces
                    </h2>
                </div>

                <ol class="process__list">

                    <li class="process__item">
                        <div class="process__number">1</div>

                        <h3 class="process__title">
                            Rozmowa i kierunek
                        </h3>

                        <p class="process__description">
                            Zaczynamy od krótkiej rozmowy o Twojej firmie, ofercie i tym, co chcesz osiągnąć. Ustalamy,
                            czego potrzebuje strona i co warto na niej pokazać.
                        </p>
                    </li>

                    <li class="process__item">
                        <div class="process__number">2</div>

                        <h3 class="process__title">
                            Pomysł i projekt
                        </h3>

                        <p class="process__description">
                            Na podstawie ustaleń przygotowuję koncepcję strony. Układam treści i elementy tak, żeby
                            całość była spójna, czytelna i dobrze przedstawiała Twoją firmę.
                        </p>
                    </li>

                    <li class="process__item">
                        <div class="process__number">3</div>

                        <h3 class="process__title">
                            Tworzenie strony
                        </h3>

                        <p class="process__description">
                            Przenoszę projekt do działającej strony. Dbam o szczegóły, wygodne korzystanie na telefonie
                            i komputerze oraz to, żeby wszystko działało tak, jak powinno.
                        </p>
                    </li>

                    <li class="process__item">
                        <div class="process__number">4</div>

                        <h3 class="process__title">
                            Publikacja
                        </h3>

                        <p class="process__description">
                            Po wspólnym sprawdzeniu strony przychodzi czas na jej uruchomienie. Pomagam dopiąć ostatnie
                            szczegóły i publikuję gotową stronę w internecie.
                        </p>
                    </li>

                </ol>
            </div>
        </section>

        <section class="conversion-panel section" id="kontakt">
            <div class="container">
                <div class="conversion-panel__box">
                    <div class="conversion-panel__content">
                        <h2 class="conversion-panel__title">
                            Masz pomysł na swoją stronę?
                        </h2>

                        <p class="conversion-panel__description">
                            Niezależnie od tego, czy dopiero zaczynasz, czy Twoja obecna strona potrzebuje zmiany -
                            możemy zacząć od rozmowy.
                        </p>
                    </div>

                    <a class="button button--primary conversion-panel__button" href="mailto:sylwia.k.lesner@gmail.com">
                        Porozmawiajmy o Twojej firmie.
